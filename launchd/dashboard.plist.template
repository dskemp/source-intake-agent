<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL_PREFIX__.claude-source-intake-ui</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.config/claude-source-intake/venv/bin/python</string>
        <string>__HOME__/Library/Scripts/claude-source-intake-ui.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/tmp/claude-source-intake-ui.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-source-intake-ui.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- PATH and CLAUDE_BIN mirror the worker plist: the dashboard's
             "Run now" button spawns worker.sh, which must be able to find
             the claude binary under launchd's minimal default PATH. -->
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>LIBRARY_PATH</key>
        <string>__LIBRARY__</string>
        <key>INBOX_PATH</key>
        <string>__INBOX__</string>
        <key>CLAUDE_BIN</key>
        <string>__CLAUDE__</string>
        <key>CATEGORY_ORDER</key>
        <string>__CATEGORY_ORDER__</string>
        <key>DOMAIN</key>
        <string>__DOMAIN__</string>
        <key>DASHBOARD_EXTRA_ORIGINS</key>
        <string>__DASHBOARD_EXTRA_ORIGINS__</string>
        <key>DASHBOARD_PORT</key>
        <string>__DASHBOARD_PORT__</string>
        <!-- Needed here too: the "Check now" button runs check-preprints.py
             with the dashboard's environment; without these it ignores the
             user's OpenAlex polite-pool opt-in and refresh cadence. -->
        <key>OPENALEX_EMAIL</key>
        <string>__OPENALEX_EMAIL__</string>
        <key>PREPRINT_REFRESH_DAYS</key>
        <string>__PREPRINT_REFRESH_DAYS__</string>
    </dict>
</dict>
</plist>
